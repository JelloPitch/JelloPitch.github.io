---
import Icon from "./Icon.astro";
---

<section id="cta" class="mx-auto max-w-6xl px-6 pb-20">
	<div
		class="relative overflow-hidden rounded-3xl bg-accent px-8 py-14 text-center md:px-16 md:py-20"
	>
		<div
			class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/20"
			aria-hidden="true"
		>
		</div>
		<div
			class="pointer-events-none absolute -bottom-20 -left-10 h-48 w-48 rounded-full bg-white/10"
			aria-hidden="true"
		>
		</div>

		<h2 class="relative text-3xl font-bold tracking-tight text-ink md:text-4xl">
			Bereit, als Pilot-Partner dabei zu sein?
		</h2>
		<p class="relative mx-auto mt-4 max-w-md text-ink/70">
			Sei mit deinem Stellplatz einer der Ersten, die Jello Pitch
			testen und mitentwickeln.
		</p>
		<a
			href="mailto:jello@t-online.de?subject=Pilotphase%20Jello%20Pitch"
			class="relative mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-7 py-3.5 text-sm font-bold text-white shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
		>
			Als Pilot-Partner bewerben
			<Icon name="arrow-right" class="h-4 w-4" />
		</a>
	</div>
</section>
