---
import Icon from "./Icon.astro";

const amenities = ["Strom", "Wasser", "WLAN", "Sanitär"];

const heroParcels = [
	{ id: "P1", status: "verfügbar", note: "", price: "16,00 €" },
	{ id: "P2", status: "verfügbar", note: "Seeblick", price: "16,00 €" },
	{ id: "P3", status: "belegt", note: "", price: "16,00 €" },
];
---

<section id="top" class="mx-auto max-w-6xl px-6 pt-14 pb-20 md:pt-20 md:pb-28">
	<div class="grid items-center gap-12 md:grid-cols-2 md:gap-8">
		<div>
			<span
				class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-3 py-1 text-xs font-semibold text-ink/70"
			>
				<Icon name="sparkles" class="h-3.5 w-3.5" />
				In Entwicklung: wir suchen Pilot-Stellplätze
			</span>

			<h1 class="mt-5 text-4xl font-bold tracking-tight text-ink md:text-5xl">
				Deine eigene Buchungsseite<br />
				mit Jello Pitch.
			</h1>

			<p class="mt-5 max-w-md text-lg text-ink/70">
				Die einfachste Buchungslösung für privatgeführte Stellplätze.
				Ob online gebucht oder persönlich eingecheckt, bei Jello läuft
				alles an einem Ort zusammen.
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="mailto:jello@t-online.de?subject=Pilotphase%20Jello%20Pitch"
					class="rounded-full bg-accent px-6 py-3 text-sm font-bold text-ink shadow-sm transition-transform hover:scale-[1.03] active:scale-[0.98]"
				>
					Kostenlos testen und mitgestalten
				</a>
			</div>
		</div>

		<div class="relative mx-auto w-full max-w-sm md:mx-0 md:ml-auto">
			<div
				class="absolute -inset-4 -z-10 rounded-[2rem] bg-accent/40 blur-2xl"
				aria-hidden="true"
			>
			</div>

			<div
				class="overflow-hidden rounded-3xl bg-white p-3 shadow-xl shadow-black/10 ring-1 ring-black/5"
			>
				<div class="flex items-center gap-2 px-1 pb-3">
					<span
						class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-xs font-bold text-ink"
					>
						W
					</span>
					<span class="text-sm font-semibold text-ink">Stellplatz Am Waldsee</span>
				</div>

				<div class="relative h-48 w-full overflow-hidden rounded-2xl">
					<img
						src="/images/stellplatz-luftbild.jpg"
						alt="Luftaufnahme des Stellplatzes Am Waldsee mit Wohnmobilen auf der Wiese"
						class="h-full w-full object-cover"
					/>
					<span
						class="absolute right-3 top-3 flex items-center gap-1 rounded-full bg-white/90 px-2 py-1 text-xs font-bold text-ink"
					>
						<Icon name="star" class="h-3 w-3 text-accent-dark" />
						4.8
					</span>
				</div>

				<div class="px-1 pt-4">
					<div class="flex items-center gap-1.5 text-xs text-ink/50">
						<Icon name="map-pin" class="h-3.5 w-3.5" />
						Uferweg 3, 87648 Seehausen am Waldsee
					</div>

					<div class="mt-3 flex flex-wrap gap-1.5">
						{
							amenities.map((a) => (
								<span class="rounded-full border border-black/10 bg-white px-2.5 py-1 text-xs font-medium text-ink/70">
									{a}
								</span>
							))
						}
					</div>

					<div class="mt-4 space-y-2">
						{
							heroParcels.map((p) => (
								<div
									class={`flex items-center justify-between rounded-xl px-3 py-2.5 ${
										p.status === "belegt" ? "bg-black/[0.03] opacity-60" : "bg-black/[0.03]"
									}`}
								>
									<div>
										<p class="text-xs text-ink/50">
											{p.id}
											{p.note && ` · ${p.note}`}
										</p>
										<p class="text-sm font-bold text-ink">{p.price} / Nacht</p>
									</div>
									<span
										class={`rounded-full px-3 py-1.5 text-xs font-bold ${
											p.status === "verfügbar" ? "bg-accent text-ink" : "bg-black/10 text-ink/60"
										}`}
									>
										{p.status === "verfügbar" ? "Verfügbar" : "Belegt"}
									</span>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
