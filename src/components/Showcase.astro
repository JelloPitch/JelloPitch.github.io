---
import Icon from "./Icon.astro";

const parcels = [
	{ id: "P1", status: "belegt", note: "", people: 4, price: "16,00 €" },
	{ id: "P2", status: "verfügbar", note: "Seeblick, Schattenplatz", people: 4, price: "16,00 €" },
	{ id: "P3", status: "belegt", note: "Großzügiger Stellplatz, Sonne", people: 6, price: "16,00 €" },
];
---

<section id="demo" class="mx-auto max-w-6xl px-6 py-20">
	<div class="max-w-xl">
		<h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
			So sieht's für deine Gäste aus.
		</h2>
		<p class="mt-4 text-lg text-ink/70">
			So einfach können deine Camper An- und Abreisen.
		</p>
	</div>

	<div class="mt-16 grid gap-16">
		<!-- Step 1: QR-Code am Eingangsschild scannen -->
		<div>
			<div class="max-w-2xl">
				<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-ink">1</span>
				<h3 class="mt-4 text-xl font-bold text-ink">Buchungsseite aufrufen</h3>
				<p class="mt-2 text-ink/70">
					Dein Gast gelangt über deine Website, über Apps wie
					Park4Night oder über einen QR-Code am Eingang direkt auf
					deine Buchungsseite.
				</p>
				<p class="mt-4 text-ink/70">
					Bevorzugt dein Gast den persönlichen Kontakt, trägst du die
					Buchung in wenigen Klicks selbst ein. So läuft alles an
					einem Ort zusammen.
				</p>
			</div>

			<div class="relative mt-8 flex flex-col gap-6 sm:block">
				<img
					src="/images/app-mit-link.png"
					alt="Die Buchungsseite eingebunden in eine App wie Park4Night"
					class="mx-auto w-full rounded-2xl sm:absolute sm:-bottom-6 sm:left-0 sm:z-10 sm:mx-0 sm:w-[38%] sm:rounded-none sm:drop-shadow-2xl"
				/>
				<img
					src="/images/schild-mit-qr.png"
					alt="Check-in-Schild am Stellplatz Am Waldsee mit QR-Code"
					class="w-full rounded-2xl sm:aspect-video sm:object-cover"
				/>
			</div>
		</div>

		<!-- Step 2: Parzelle wählen -->
		<div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
			<div class="order-2 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-black/5 md:order-1">
				<div class="flex items-center justify-between">
					<h4 class="text-sm font-bold text-ink">Parzelle wählen</h4>
					<span class="text-xs text-ink/50">Heute · 22. Aug</span>
				</div>

				<div class="mt-4 space-y-2.5">
					{
						parcels.map((p) => (
							<div
								class={`flex items-center justify-between rounded-xl border px-4 py-3 ${
									p.status === "belegt"
										? "border-black/5 bg-black/[0.03] opacity-60"
										: "border-black/10 bg-white"
								}`}
							>
								<div>
									<div class="flex items-center gap-2">
										<span class="text-sm font-bold text-ink">{p.id}</span>
										<span
											class={`rounded-full px-2 py-0.5 text-[11px] font-semibold ${
												p.status === "verfügbar"
													? "bg-accent text-ink"
													: "bg-black/10 text-ink/60"
											}`}
										>
											{p.status === "verfügbar" ? "Verfügbar" : "Belegt"}
										</span>
									</div>
									{p.note && <p class="mt-1 text-xs text-ink/50">{p.note}</p>}
								</div>
								<div class="flex items-center gap-3 text-xs text-ink/60">
									<span class="flex items-center gap-1">
										<Icon name="users" class="h-3.5 w-3.5" />
										{p.people}
									</span>
									<span class="text-sm font-bold text-ink">{p.price}</span>
								</div>
							</div>
						))
					}
				</div>

				<div class="mt-4">
					<p class="text-xs font-bold text-ink/50">Lageplan</p>
					<div class="mt-1.5 overflow-hidden rounded-xl">
						<img
							src="/images/lageplan.png"
							alt="Lageplan des Stellplatzes Am Waldsee mit Parzellen P1 bis P3, Sanitäranlagen und Hundeplatz"
							class="aspect-[16/9] w-full object-cover"
						/>
					</div>
				</div>

				<button
					disabled
					class="mt-4 w-full rounded-xl bg-accent/50 py-3 text-sm font-bold text-ink/50"
				>
					Einchecken →
				</button>
			</div>

			<div class="order-1 md:order-2">
				<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-ink">2</span>
				<h3 class="mt-4 text-xl font-bold text-ink">Parzelle wählen</h3>
				<p class="mt-2 text-ink/70">
					Auf deiner Buchungsseite sieht dein Camper neben allen
					wichtigen Infos deines Stellplatzes auch den aktuellen
					Belegungsstatus. Hier wählt er seinen gewünschten Platz aus
					und checkt in einem Schritt ein.
				</p>
			</div>
		</div>

		<!-- Step 3: Kontaktdaten eingeben -->
		<div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
			<div>
				<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-ink">3</span>
				<h3 class="mt-4 text-xl font-bold text-ink">Kontaktdaten eingeben</h3>
				<p class="mt-2 text-ink/70">
					Zum Einchecken werden die wichtigsten Kundendaten erfasst.
					Fertig.
				</p>
			</div>

			<div class="space-y-4">
				<div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-black/5">
					<div class="flex items-center justify-between py-3">
						<span class="flex items-center gap-2 text-sm text-ink/50">
							<Icon name="calendar" class="h-4 w-4" />
							Check-in Tag
						</span>
						<span class="flex items-center gap-1.5 text-sm font-bold text-ink">
							Heute
							<span class="flex items-center gap-1 font-bold text-ink">
								<Icon name="clock" class="h-3.5 w-3.5" />
								17:35 Uhr
							</span>
						</span>
					</div>
					<div class="flex items-center justify-between border-t border-black/5 py-3">
						<span class="flex items-center gap-2 text-sm text-ink/50">
							<Icon name="map-pin" class="h-4 w-4" />
							Parzelle
						</span>
						<span class="text-sm font-bold text-ink">P2</span>
					</div>
					<div class="flex items-center justify-between border-t border-black/5 py-3">
						<span class="flex items-center gap-2 text-sm text-ink/50">
							<Icon name="euro" class="h-4 w-4" />
							Preis je Nacht
						</span>
						<span class="text-sm font-bold text-ink">16,00 €</span>
					</div>
					<div class="flex items-center justify-between border-t border-black/5 py-3">
						<span class="flex items-center gap-2 text-sm text-ink/50">
							<Icon name="bolt" class="h-4 w-4" />
							Strompauschale
						</span>
						<span class="text-sm font-bold text-ink">3,00 €</span>
					</div>
					<div class="flex items-center justify-between border-t border-black/5 py-3">
						<span class="flex items-center gap-2 text-sm text-ink/50">
							<Icon name="clock" class="h-4 w-4" />
							Late-Check-out
						</span>
						<span class="text-sm font-bold text-ink">11:00–23:59 Uhr · +5,00 €</span>
					</div>
				</div>

				<div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-black/5">
				<div class="flex items-center gap-2">
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-accent">
						<Icon name="user" class="h-4 w-4 text-ink" />
					</div>
					<h4 class="text-sm font-bold text-ink">Deine Daten</h4>
				</div>

				<div class="mt-4 space-y-2.5">
					<div class="rounded-xl bg-black/[0.03] px-4 py-3">
						<p class="text-[11px] font-semibold text-ink/50">Name</p>
						<p class="text-sm font-semibold text-ink">Max Mustermann</p>
					</div>
					<div class="grid grid-cols-2 gap-2.5">
						<div class="rounded-xl bg-black/[0.03] px-4 py-3">
							<p class="text-[11px] font-semibold text-ink/50">E-Mail</p>
							<p class="text-sm font-semibold text-ink">max@beispiel.de</p>
						</div>
						<div class="rounded-xl bg-black/[0.03] px-4 py-3">
							<p class="text-[11px] font-semibold text-ink/50">Telefon</p>
							<p class="text-sm font-semibold text-ink">0176 55849213</p>
						</div>
					</div>
					<div class="grid grid-cols-2 gap-2.5">
						<div class="rounded-xl bg-black/[0.03] px-4 py-3">
							<p class="text-[11px] font-semibold text-ink/50">Personen</p>
							<p class="text-sm font-semibold text-ink">2</p>
						</div>
						<div class="rounded-xl bg-black/[0.03] px-4 py-3">
							<p class="text-[11px] font-semibold text-ink/50">Kennzeichen</p>
							<p class="text-sm font-semibold text-ink">M-AB 1234</p>
						</div>
					</div>
				</div>

				<button class="mt-4 w-full rounded-xl bg-accent py-3 text-sm font-bold text-ink">
					Weiter zur Bestätigung →
				</button>
				</div>
			</div>
		</div>

		<!-- Step 4: Automatische Bestätigung -->
		<div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
			<div class="order-2 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-black/5 md:order-1">
				<div class="flex items-center gap-2">
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-accent">
						<Icon name="mail" class="h-4 w-4 text-ink" />
					</div>
					<span class="text-xs font-bold text-ink/50">Automatisch verschickt</span>
				</div>

				<div class="mt-4 rounded-xl border border-black/10 p-4">
					<p class="text-sm font-bold text-ink">Deine Buchung ist bestätigt ✓</p>
					<div class="mt-3 space-y-2 text-xs">
						<div class="flex items-center justify-between">
							<span class="text-ink/50">Buchungsnummer</span>
							<span class="font-semibold text-ink">WB-240814</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-ink/50">Parzelle</span>
							<span class="font-semibold text-ink">Parzelle 2</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-ink/50">Anreise</span>
							<span class="font-semibold text-ink">14. August 2026</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-ink/50">Personen</span>
							<span class="font-semibold text-ink">2 Personen</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-ink/50">Preis je Nacht</span>
							<span class="font-semibold text-ink">16,00 €</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="text-ink/50">Strompauschale</span>
							<span class="font-semibold text-ink">3,00 €</span>
						</div>
					</div>
					<p class="mt-3 text-[11px] text-ink/40">
						Der Gesamtpreis wird am Tag deines Check-outs berechnet.
					</p>
				</div>

				<div class="mt-3 rounded-xl bg-black/[0.03] p-4">
					<p class="text-xs font-bold text-ink/50">Stellplatz-Infos</p>
					<div class="mt-3 space-y-2.5 text-xs">
						<div class="flex items-center justify-between">
							<span class="flex items-center gap-1.5 text-ink/50">
								<Icon name="wifi" class="h-3.5 w-3.5" />
								WLAN-Zugang
							</span>
							<span class="font-semibold text-ink">Waldsee-Gast · camping2026</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="flex items-center gap-1.5 text-ink/50">
								<Icon name="clock" class="h-3.5 w-3.5" />
								Check-out
							</span>
							<span class="font-semibold text-ink">bis 11:00 Uhr</span>
						</div>
						<div class="flex items-center justify-between">
							<span class="flex items-center gap-1.5 text-ink/50">
								<Icon name="clock" class="h-3.5 w-3.5" />
								Late-Check-out
							</span>
							<span class="font-semibold text-ink">11:00–23:59 Uhr · +5,00 €</span>
						</div>
					</div>
				</div>
			</div>

			<div class="order-1 md:order-2">
				<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-ink">4</span>
				<h3 class="mt-4 text-xl font-bold text-ink">Automatische Bestätigung</h3>
				<p class="mt-2 text-ink/70">
					Sofort nach der Buchung landet die Bestätigung mit allen Infos
					im Postfach des Gasts, ganz ohne dein Zutun.
				</p>
			</div>
		</div>

		<!-- Step 5: Check-out & Bezahlen -->
		<div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
			<div class="order-1 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-black/5 md:order-2">
				<div class="flex items-center gap-2">
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-accent">
						<Icon name="credit-card" class="h-4 w-4 text-ink" />
					</div>
					<h4 class="text-sm font-bold text-ink">Check-out</h4>
				</div>

				<div class="mt-4 space-y-2 text-sm">
					<div class="flex items-center justify-between text-ink/70">
						<span>3 Nächte × 16,00 €</span>
						<span class="font-semibold text-ink">48,00 €</span>
					</div>
					<div class="flex items-center justify-between text-ink/70">
						<span>Strompauschale · 3 Nächte × 3,00 €</span>
						<span class="font-semibold text-ink">9,00 €</span>
					</div>
					<div class="flex items-center justify-between border-t border-black/10 pt-2 text-base">
						<span class="font-bold text-ink">Gesamt</span>
						<span class="font-bold text-ink">57,00 €</span>
					</div>
				</div>

				<button class="mt-4 w-full rounded-xl bg-accent py-3 text-sm font-bold text-ink">
					Jetzt bezahlen & los
				</button>
			</div>

			<div class="order-2 md:order-1">
				<span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-accent text-sm font-bold text-ink">5</span>
				<h3 class="mt-4 text-xl font-bold text-ink">Check-out & Bezahlen</h3>
				<p class="mt-2 text-ink/70">
					Nummernschild bestätigen und direkt online bezahlen. Schon
					hat sich dein Gast erfolgreich ausgecheckt und die
					Bezahlung geht auf deinem Konto ein.
				</p>
			</div>
		</div>
	</div>
</section>
