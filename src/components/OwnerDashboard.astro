---
import Icon from "./Icon.astro";
---

<section id="dashboard" class="mx-auto max-w-6xl px-6 py-20">
	<div class="max-w-xl">
		<h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
			Auch du als Besitzer hast alles im Blick.
		</h2>
		<p class="mt-4 text-lg text-ink/70">
			Dein Dashboard zeigt dir Buchungen, Kalender, Einnahmen und mehr
			auf einen Blick.
		</p>
	</div>

	<div
		class="mt-10 -mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
	>
		<!-- Slide 1: Buchungen mit Kundenprofil -->
		<figure class="w-[82%] shrink-0 snap-start sm:w-[380px]">
			<div class="flex rounded-3xl shadow-sm ring-1 ring-black/5">
				<div
					class="flex w-11 shrink-0 flex-col items-center gap-3 rounded-l-3xl bg-black/[0.03] py-4"
				>
					<span
						class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-[11px] font-bold text-ink"
					>
						W
					</span>
					<Icon name="layout-grid" class="h-4 w-4 text-ink/25" />
					<span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent">
						<Icon name="book" class="h-3.5 w-3.5 text-ink" />
					</span>
					<Icon name="calendar" class="h-4 w-4 text-ink/25" />
					<Icon name="euro" class="h-4 w-4 text-ink/25" />
					<Icon name="clipboard" class="h-4 w-4 text-ink/25" />
					<Icon name="settings" class="h-4 w-4 text-ink/25" />
				</div>

				<div class="flex-1 rounded-r-3xl bg-white p-4">
					<p class="text-sm font-bold text-ink">Buchungen</p>
					<p class="text-[11px] text-ink/50">10 Buchungen gesamt</p>

					<div class="relative mt-3">
						<div class="space-y-2">
							<div
								class="flex items-center justify-between rounded-xl bg-black/[0.03] px-3 py-2.5"
							>
								<div>
									<p class="text-xs font-bold text-ink">Nane Maurer</p>
									<p class="text-[11px] text-ink/50">WB-670725 · P1</p>
								</div>
								<div class="text-right">
									<span
										class="rounded-full bg-accent px-2 py-0.5 text-[10px] font-semibold text-ink"
									>
										Aktiv
									</span>
									<p class="mt-1 text-xs font-bold text-ink">0,00 €</p>
								</div>
							</div>
							<div
								class="flex items-center justify-between rounded-xl bg-black/[0.03] px-3 py-2.5 opacity-40"
							>
								<div>
									<p class="text-xs font-bold text-ink">Familie Müller</p>
									<p class="text-[11px] text-ink/50">WB-1124 · P1</p>
								</div>
								<div class="text-right">
									<span
										class="rounded-full bg-black/10 px-2 py-0.5 text-[10px] font-semibold text-ink/60"
									>
										Abgeschlossen
									</span>
									<p class="mt-1 text-xs font-bold text-ink">33,08 €</p>
								</div>
							</div>
						</div>

						<div
							class="absolute -bottom-16 left-3 right-3 rounded-2xl bg-white p-3 shadow-xl ring-1 ring-black/10"
						>
							<div class="flex items-center gap-2">
								<span
									class="flex h-7 w-7 items-center justify-center rounded-full bg-accent text-xs font-bold text-ink"
								>
									N
								</span>
								<div>
									<p class="text-xs font-bold text-ink">Nane Maurer</p>
									<p class="text-[10px] text-ink/50">Braunschweig</p>
								</div>
							</div>
							<button
								class="mt-2 w-full rounded-lg bg-accent py-1.5 text-[11px] font-bold text-ink"
							>
								Kundenprofil öffnen
							</button>
						</div>
					</div>

					<div class="h-14" aria-hidden="true"></div>
				</div>
			</div>

			<figcaption class="mt-4">
				<p class="text-sm font-bold text-ink">Buchungen &amp; Kundenprofile</p>
				<p class="mt-1 text-sm text-ink/60">
					Jede Buchung im Überblick. Ein Klick öffnet das passende
					Kundenprofil.
				</p>
			</figcaption>
		</figure>

		<!-- Slide 2: Kalender -->
		<figure class="w-[82%] shrink-0 snap-start sm:w-[380px]">
			<div class="flex rounded-3xl shadow-sm ring-1 ring-black/5">
				<div
					class="flex w-11 shrink-0 flex-col items-center gap-3 rounded-l-3xl bg-black/[0.03] py-4"
				>
					<span
						class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-[11px] font-bold text-ink"
					>
						W
					</span>
					<Icon name="layout-grid" class="h-4 w-4 text-ink/25" />
					<Icon name="book" class="h-4 w-4 text-ink/25" />
					<span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent">
						<Icon name="calendar" class="h-3.5 w-3.5 text-ink" />
					</span>
					<Icon name="euro" class="h-4 w-4 text-ink/25" />
					<Icon name="clipboard" class="h-4 w-4 text-ink/25" />
					<Icon name="settings" class="h-4 w-4 text-ink/25" />
				</div>

				<div class="flex-1 rounded-r-3xl bg-white p-4">
					<p class="text-sm font-bold text-ink">Kalender</p>
					<p class="text-[11px] text-ink/50">Preis- &amp; Sperrkalender</p>

					<div class="mt-3 flex gap-1.5">
						<span class="rounded-full bg-ink px-2.5 py-1 text-[10px] font-semibold text-white">
							P1
						</span>
						<span class="rounded-full bg-black/[0.03] px-2.5 py-1 text-[10px] font-semibold text-ink/50">
							P2
						</span>
						<span class="rounded-full bg-black/[0.03] px-2.5 py-1 text-[10px] font-semibold text-ink/50">
							P3
						</span>
						<span class="rounded-full bg-black/[0.03] px-2.5 py-1 text-[10px] font-semibold text-ink/50">
							P4
						</span>
					</div>

					<p class="mt-3 text-center text-[11px] font-bold text-ink">August 2026</p>

					<div class="mt-2 grid grid-cols-7 gap-1 text-center text-[9px] text-ink/40">
						<span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span>
					</div>
					<div class="mt-1 grid grid-cols-7 gap-1">
						{
							Array.from({ length: 14 }).map((_, i) => (
								<div class={`rounded-md py-1 ${i === 10 ? "bg-accent" : "bg-black/[0.03]"}`}>
									<p class="text-[10px] font-bold text-ink">{i + 1}</p>
									<p class="text-[8px] text-ink/40">25€</p>
								</div>
							))
						}
					</div>

					<div class="mt-3 rounded-xl bg-black/[0.03] p-3">
						<p class="text-[11px] font-bold text-ink">11. August</p>
						<div class="mt-2 flex items-center justify-between">
							<span class="text-[11px] text-ink/50">Tagespreis</span>
							<span class="text-xs font-bold text-ink">25 €</span>
						</div>
						<div class="mt-1.5 flex items-center justify-between">
							<span class="flex items-center gap-1 text-[11px] text-ink/50">
								<Icon name="lock" class="h-3 w-3" />
								Verfügbar
							</span>
							<span class="h-4 w-7 rounded-full bg-accent"></span>
						</div>
					</div>
				</div>
			</div>

			<figcaption class="mt-4">
				<p class="text-sm font-bold text-ink">Preis- &amp; Sperrkalender</p>
				<p class="mt-1 text-sm text-ink/60">
					Tagespreise anpassen oder Parzellen sperren, direkt im
					Kalender.
				</p>
			</figcaption>
		</figure>

		<!-- Slide 3: Einnahmen im Dashboardformat -->
		<figure class="w-[82%] shrink-0 snap-start sm:w-[380px]">
			<div class="flex rounded-3xl shadow-sm ring-1 ring-black/5">
				<div
					class="flex w-11 shrink-0 flex-col items-center gap-3 rounded-l-3xl bg-black/[0.03] py-4"
				>
					<span
						class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-[11px] font-bold text-ink"
					>
						W
					</span>
					<Icon name="layout-grid" class="h-4 w-4 text-ink/25" />
					<Icon name="book" class="h-4 w-4 text-ink/25" />
					<Icon name="calendar" class="h-4 w-4 text-ink/25" />
					<span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent">
						<Icon name="euro" class="h-3.5 w-3.5 text-ink" />
					</span>
					<Icon name="clipboard" class="h-4 w-4 text-ink/25" />
					<Icon name="settings" class="h-4 w-4 text-ink/25" />
				</div>

				<div class="flex-1 rounded-r-3xl bg-white p-4">
					<p class="text-sm font-bold text-ink">Einnahmen</p>
					<p class="text-[11px] text-ink/50">Diesen Monat</p>

					<div class="mt-3 rounded-xl bg-black/[0.03] p-3">
						<div class="flex items-center gap-1.5 text-[11px] text-ink/50">
							<Icon name="euro" class="h-3.5 w-3.5" />
							Einnahmen diesen Monat
						</div>
						<p class="mt-1 text-2xl font-bold text-ink">572,77 €</p>
						<p class="mt-1 flex items-center gap-1 text-[11px] font-semibold text-emerald-600">
							<Icon name="trending-up" class="h-3 w-3" />
							+12,5 % vs. Vormonat
						</p>
					</div>

					<div class="mt-2 grid grid-cols-2 gap-2">
						<div class="rounded-xl bg-black/[0.03] p-3">
							<p class="text-[10px] text-ink/50">Einnahmen Jahr</p>
							<p class="mt-1 text-sm font-bold text-ink">930 €</p>
						</div>
						<div class="rounded-xl bg-black/[0.03] p-3">
							<p class="text-[10px] text-ink/50">Aktive Buchungen</p>
							<p class="mt-1 text-sm font-bold text-ink">2</p>
						</div>
						<div class="rounded-xl bg-black/[0.03] p-3">
							<p class="text-[10px] text-ink/50">Anstehend</p>
							<p class="mt-1 text-sm font-bold text-ink">3</p>
						</div>
						<div class="rounded-xl bg-black/[0.03] p-3">
							<p class="text-[10px] text-ink/50">Bestbezahlte Parzelle</p>
							<p class="mt-1 text-sm font-bold text-ink">P1</p>
						</div>
					</div>
				</div>
			</div>

			<figcaption class="mt-4">
				<p class="text-sm font-bold text-ink">Einnahmen im Blick</p>
				<p class="mt-1 text-sm text-ink/60">
					Umsatz, aktive und anstehende Buchungen auf einen Blick.
				</p>
			</figcaption>
		</figure>

		<!-- Slide 4: Meldewesen -->
		<figure class="w-[82%] shrink-0 snap-start sm:w-[380px]">
			<div class="flex rounded-3xl shadow-sm ring-1 ring-black/5">
				<div
					class="flex w-11 shrink-0 flex-col items-center gap-3 rounded-l-3xl bg-black/[0.03] py-4"
				>
					<span
						class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-[11px] font-bold text-ink"
					>
						W
					</span>
					<Icon name="layout-grid" class="h-4 w-4 text-ink/25" />
					<Icon name="book" class="h-4 w-4 text-ink/25" />
					<Icon name="calendar" class="h-4 w-4 text-ink/25" />
					<Icon name="euro" class="h-4 w-4 text-ink/25" />
					<span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent">
						<Icon name="clipboard" class="h-3.5 w-3.5 text-ink" />
					</span>
					<Icon name="settings" class="h-4 w-4 text-ink/25" />
				</div>

				<div class="flex-1 rounded-r-3xl bg-white p-4">
					<p class="text-sm font-bold text-ink">Meldewesen</p>
					<p class="text-[11px] text-ink/50">Digitale Meldescheine &amp; Export</p>

					<div class="mt-3 rounded-xl bg-black/[0.03] p-3">
						<div class="flex items-center gap-1.5 text-[11px] font-bold text-ink">
							<Icon name="clipboard" class="h-3.5 w-3.5" />
							Nachregister-Export
						</div>
						<p class="mt-1 text-[10px] text-ink/50">
							CSV-Export pro Zeitraum, ganz ohne Live-API.
						</p>
						<button
							class="mt-2 w-full rounded-lg bg-accent py-1.5 text-[11px] font-bold text-ink"
						>
							CSV exportieren (10)
						</button>
					</div>

					<div class="mt-2 rounded-xl bg-white p-3 ring-1 ring-black/5">
						<div class="flex items-center justify-between">
							<p class="text-xs font-bold text-ink">Nani</p>
							<span class="rounded-full bg-black/10 px-2 py-0.5 text-[10px] font-semibold text-ink/60">
								Österreich
							</span>
						</div>
						<p class="text-[10px] text-ink/50">WB-993850 · Anreise 17. Aug.</p>
						<div class="mt-2 grid grid-cols-2 gap-2 text-[10px]">
							<div>
								<p class="text-ink/40">Geburtsdatum</p>
								<p class="font-semibold text-ink">14.11.1997</p>
							</div>
							<div>
								<p class="text-ink/40">Unterschrift</p>
								<p class="font-semibold text-ink">erfasst ✓</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<figcaption class="mt-4">
				<p class="text-sm font-bold text-ink">Digitales Meldewesen</p>
				<p class="mt-1 text-sm text-ink/60">
					Meldescheine erfassen und für die Kurtaxe als CSV
					exportieren.
				</p>
			</figcaption>
		</figure>

		<!-- Slide 5: Stellplatzeinstellungen -->
		<figure class="w-[82%] shrink-0 snap-start sm:w-[380px]">
			<div class="flex rounded-3xl shadow-sm ring-1 ring-black/5">
				<div
					class="flex w-11 shrink-0 flex-col items-center gap-3 rounded-l-3xl bg-black/[0.03] py-4"
				>
					<span
						class="flex h-6 w-6 items-center justify-center rounded-md bg-accent text-[11px] font-bold text-ink"
					>
						W
					</span>
					<Icon name="layout-grid" class="h-4 w-4 text-ink/25" />
					<Icon name="book" class="h-4 w-4 text-ink/25" />
					<Icon name="calendar" class="h-4 w-4 text-ink/25" />
					<Icon name="euro" class="h-4 w-4 text-ink/25" />
					<Icon name="clipboard" class="h-4 w-4 text-ink/25" />
					<span class="flex h-6 w-6 items-center justify-center rounded-md bg-accent">
						<Icon name="settings" class="h-3.5 w-3.5 text-ink" />
					</span>
				</div>

				<div class="flex-1 rounded-r-3xl bg-white p-4">
					<p class="text-sm font-bold text-ink">Stellplatz</p>
					<p class="text-[11px] text-ink/50">Einstellungen verwalten</p>

					<div class="mt-3 space-y-2">
						<div class="rounded-lg bg-black/[0.03] px-3 py-2">
							<p class="text-[9px] font-semibold text-ink/40">Name</p>
							<p class="text-xs font-semibold text-ink">Stellplatz Am Waldsee</p>
						</div>
						<div class="rounded-lg bg-black/[0.03] px-3 py-2">
							<p class="text-[9px] font-semibold text-ink/40">Adresse</p>
							<p class="text-xs font-semibold text-ink">Uferweg 3, 87648 Seehausen</p>
						</div>
					</div>

					<div class="mt-3 flex flex-wrap gap-1.5">
						<span class="rounded-full bg-accent px-2 py-1 text-[10px] font-semibold text-ink">
							Strom
						</span>
						<span class="rounded-full bg-accent px-2 py-1 text-[10px] font-semibold text-ink">
							Wasser
						</span>
						<span class="rounded-full bg-accent px-2 py-1 text-[10px] font-semibold text-ink">
							WLAN
						</span>
						<span class="rounded-full bg-black/[0.05] px-2 py-1 text-[10px] font-semibold text-ink/40">
							Hunde erlaubt
						</span>
					</div>

					<div class="mt-3 flex items-center justify-between rounded-xl bg-black/[0.03] p-3">
						<div>
							<div class="flex items-center gap-1.5">
								<p class="text-xs font-bold text-ink">P1</p>
								<span class="rounded-full bg-accent px-1.5 py-0.5 text-[9px] font-semibold text-ink">
									Aktiv
								</span>
							</div>
							<p class="mt-1 text-[10px] text-ink/50">Basispreis 25 € · max. 4 Personen</p>
						</div>
						<Icon name="settings" class="h-4 w-4 text-ink/30" />
					</div>
				</div>
			</div>

			<figcaption class="mt-4">
				<p class="text-sm font-bold text-ink">Stellplatz-Einstellungen</p>
				<p class="mt-1 text-sm text-ink/60">
					Stammdaten, Ausstattung und Parzellen jederzeit selbst
					verwalten.
				</p>
			</figcaption>
		</figure>
	</div>
</section>
