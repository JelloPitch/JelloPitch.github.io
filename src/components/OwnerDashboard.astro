---
import Icon from "./Icon.astro";

const bookings = [
	{
		id: "WB-1125",
		parzelle: "P2",
		anreise: "05. Aug.",
		checkout: "offen",
		kunde: "Max Mustermann",
		status: "aktiv",
		einnahme: "0,00 €",
		zahlung: "ausstehend",
	},
	{
		id: "WB-487139",
		parzelle: "P3",
		anreise: "06. Aug.",
		checkout: "offen",
		kunde: "Lukas Schneider",
		status: "aktiv",
		einnahme: "0,00 €",
		zahlung: "ausstehend",
	},
	{
		id: "WB-920314",
		parzelle: "P1",
		anreise: "02. Aug.",
		checkout: "10. Aug.",
		kunde: "Sophie Becker",
		status: "bezahlt",
		einnahme: "216,83 €",
		zahlung: "bezahlt",
	},
	{
		id: "WB-191133",
		parzelle: "P1",
		anreise: "15. Aug.",
		checkout: "16. Aug.",
		kunde: "Tim Fischer",
		status: "bezahlt",
		einnahme: "33,08 €",
		zahlung: "bezahlt",
	},
	{
		id: "WB-1124",
		parzelle: "P1",
		anreise: "31. Juli",
		checkout: "02. Aug.",
		kunde: "Familie Müller",
		status: "bezahlt",
		einnahme: "33,08 €",
		zahlung: "bezahlt",
	},
	{
		id: "WB-670725",
		parzelle: "P1",
		anreise: "11. Aug.",
		checkout: "14. Aug.",
		kunde: "Julia Hoffmann",
		status: "bezahlt",
		einnahme: "96,00 €",
		zahlung: "bezahlt",
	},
	{
		id: "WB-1126",
		parzelle: "P3",
		anreise: "07. Aug.",
		checkout: "11. Aug.",
		kunde: "Susanne Wagner",
		status: "bezahlt",
		einnahme: "140,70 €",
		zahlung: "bezahlt",
	},
	{
		id: "WB-1127",
		parzelle: "P5",
		anreise: "08. Aug.",
		checkout: "12. Aug.",
		kunde: "Familie Schmidt",
		status: "bezahlt",
		einnahme: "202,13 €",
		zahlung: "bezahlt",
	},
];

const statusPill: Record<string, string> = {
	aktiv: "bg-accent text-ink",
	bezahlt: "bg-black/10 text-ink/60",
};
const statusDot: Record<string, string> = {
	aktiv: "bg-ink",
	bezahlt: "bg-ink/40",
};
const statusLabel: Record<string, string> = {
	aktiv: "Aktiv",
	bezahlt: "Bezahlt",
};
---

<section id="dashboard" class="mx-auto max-w-6xl px-6 py-20">
	<div class="max-w-xl">
		<h2 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">
			Auch du als Besitzer hast alles im Blick.
		</h2>
		<p class="mt-4 text-lg text-ink/70">
			Alle Buchungen auf einen Blick, inklusive Kundenprofil per
			Klick.
		</p>
	</div>

	<div class="mt-10 -mx-6 overflow-x-auto px-6 pb-4">
		<div class="flex min-w-[940px] rounded-3xl shadow-sm ring-1 ring-black/5">
			<div class="w-44 shrink-0 rounded-l-3xl border-r border-black/5 bg-black/[0.02] p-4">
				<div class="flex items-center gap-2 px-1">
					<span
						class="flex h-7 w-7 items-center justify-center rounded-md bg-accent text-xs font-bold text-ink"
					>
						W
					</span>
					<span class="text-xs font-bold text-ink">Wohnmobilstellplatz</span>
				</div>

				<nav class="mt-6 space-y-1">
					<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-ink/50">
						<Icon name="layout-grid" class="h-3.5 w-3.5" />
						Übersicht
					</div>
					<div class="flex items-center gap-2.5 rounded-lg bg-accent px-3 py-2 text-xs font-semibold text-ink">
						<Icon name="book" class="h-3.5 w-3.5" />
						Buchungen
					</div>
					<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-ink/50">
						<Icon name="calendar" class="h-3.5 w-3.5" />
						Kalender
					</div>
					<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-ink/50">
						<Icon name="wallet" class="h-3.5 w-3.5" />
						Einnahmen
					</div>
					<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-ink/50">
						<Icon name="clipboard" class="h-3.5 w-3.5" />
						Meldewesen
					</div>
					<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-ink/50">
						<Icon name="settings" class="h-3.5 w-3.5" />
						Stellplatz
					</div>
					<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-ink/50">
						<Icon name="user" class="h-3.5 w-3.5" />
						Konto
					</div>
				</nav>
			</div>

			<div class="flex-1 rounded-r-3xl bg-white p-5">
				<div class="flex items-center justify-between">
					<div>
						<p class="text-base font-bold text-ink">Buchungen</p>
						<p class="text-[11px] text-ink/50">10 Buchungen gesamt</p>
					</div>
					<button class="flex items-center gap-1.5 rounded-lg bg-accent px-3 py-2 text-[11px] font-bold text-ink">
						<Icon name="user-plus" class="h-3.5 w-3.5" />
						Gast einchecken
					</button>
				</div>

				<div class="mt-4 grid grid-cols-4 gap-3">
					<div class="rounded-xl bg-black/[0.03] p-3">
						<p class="text-[10px] text-ink/50">Anreisen heute</p>
						<p class="mt-1 text-lg font-bold text-ink">0</p>
					</div>
					<div class="rounded-xl bg-black/[0.03] p-3">
						<p class="text-[10px] text-ink/50">Abreisen heute</p>
						<p class="mt-1 text-lg font-bold text-ink">0</p>
					</div>
					<div class="rounded-xl bg-black/[0.03] p-3">
						<p class="text-[10px] text-ink/50">Aktiv vor Ort</p>
						<p class="mt-1 text-lg font-bold text-ink">2</p>
					</div>
					<div class="rounded-xl bg-black/[0.03] p-3">
						<p class="text-[10px] text-ink/50">Gesamteinnahmen</p>
						<p class="mt-1 text-lg font-bold text-ink">929,77 €</p>
					</div>
				</div>

				<div class="mt-4 flex items-center gap-2">
					<div class="flex flex-1 items-center gap-2 rounded-lg bg-black/[0.03] px-3 py-2">
						<Icon name="search" class="h-3.5 w-3.5 text-ink/30" />
						<span class="text-[11px] text-ink/40">Suchen und filtern</span>
					</div>
					<div class="flex items-center gap-1.5 rounded-lg border border-black/10 px-3 py-2">
						<span class="text-[11px] font-medium text-ink/60">Alle</span>
						<Icon name="chevron-down" class="h-3 w-3 text-ink/40" />
					</div>
				</div>

				<div class="relative mt-3">
					<table class="w-full min-w-[680px] border-collapse text-left">
						<thead>
							<tr class="text-[10px] uppercase tracking-wide text-ink/40">
								<th class="pb-2 pr-2 font-semibold">Buchung</th>
								<th class="pb-2 pr-2 font-semibold">Anreise</th>
								<th class="pb-2 pr-2 font-semibold">Check-out</th>
								<th class="pb-2 pr-2 font-semibold">Kunde</th>
								<th class="pb-2 pr-2 font-semibold">Status</th>
								<th class="pb-2 pr-2 text-right font-semibold">Einnahme</th>
								<th class="pb-2 pr-2 font-semibold">Zahlung</th>
								<th class="pb-2 pr-2 font-semibold">Mail</th>
								<th class="pb-2 text-right font-semibold">Aktion</th>
							</tr>
						</thead>
						<tbody>
							{
								bookings.map((b) => (
									<tr class="border-t border-black/5">
										<td class="py-2.5 pr-2">
											<p class="text-xs font-bold text-ink">{b.id}</p>
											<p class="text-[10px] text-ink/40">{b.parzelle}</p>
										</td>
										<td class="py-2.5 pr-2 text-xs text-ink/60">{b.anreise}</td>
										<td class="py-2.5 pr-2">
											{b.checkout === "offen" ? (
												<span class="inline-flex items-center gap-1 rounded-full bg-black/5 px-2 py-0.5 text-[10px] font-semibold text-ink/70">
													<span class="h-1.5 w-1.5 rounded-full bg-ink" />
													Offen
												</span>
											) : (
												<span class="text-xs text-ink/60">{b.checkout}</span>
											)}
										</td>
										<td class="relative py-2.5 pr-2 text-xs font-semibold text-ink">
											{b.kunde}
											{b.kunde === "Max Mustermann" && (
												<div class="absolute left-0 top-full z-10 mt-8 w-56 rounded-2xl bg-white p-4 shadow-xl ring-1 ring-black/10">
													<svg
														class="pointer-events-none absolute -top-7 left-6 h-8 w-10 text-ink/50"
														viewBox="0 0 40 32"
														fill="none"
													>
														<path
															d="M4 28C4 14 18 6 34 4"
															stroke="currentColor"
															stroke-width="2"
															stroke-linecap="round"
														/>
														<path
															d="M27 3 L35 4 L32 11"
															stroke="currentColor"
															stroke-width="2"
															stroke-linecap="round"
															stroke-linejoin="round"
														/>
													</svg>
													<div class="flex items-center gap-2">
														<span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent text-xs font-bold text-ink">
															M
														</span>
														<div>
															<p class="text-xs font-bold text-ink">Max Mustermann</p>
															<p class="text-[10px] text-ink/50">Parzelle P2</p>
														</div>
													</div>
													<div class="mt-3 space-y-1.5 text-[10px]">
														<div class="flex items-center justify-between">
															<span class="text-ink/40">E-Mail</span>
															<span class="font-semibold text-ink">max@beispiel.de</span>
														</div>
														<div class="flex items-center justify-between">
															<span class="text-ink/40">Telefon</span>
															<span class="font-semibold text-ink">0176 55849213</span>
														</div>
														<div class="flex items-center justify-between">
															<span class="text-ink/40">Personen</span>
															<span class="font-semibold text-ink">2</span>
														</div>
														<div class="flex items-center justify-between">
															<span class="text-ink/40">Kennzeichen</span>
															<span class="font-semibold text-ink">M-AB 1234</span>
														</div>
													</div>
													<button class="mt-3 w-full rounded-lg bg-accent py-1.5 text-[11px] font-bold text-ink">
														Kundenprofil öffnen
													</button>
												</div>
											)}
										</td>
										<td class="py-2.5 pr-2">
											<span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-semibold ${statusPill[b.status]}`}>
												<span class={`h-1.5 w-1.5 rounded-full ${statusDot[b.status]}`} />
												{statusLabel[b.status]}
											</span>
										</td>
										<td class="py-2.5 pr-2 text-right text-xs font-bold text-ink">{b.einnahme}</td>
										<td class="py-2.5 pr-2">
											<span class="inline-flex items-center gap-1 text-[10px] font-medium">
												<span class={`h-1.5 w-1.5 rounded-full ${b.zahlung === "bezahlt" ? "bg-ink/40" : "bg-amber-500"}`} />
												<span class={b.zahlung === "bezahlt" ? "text-ink/50" : "text-amber-600"}>
													{b.zahlung === "bezahlt" ? "Bezahlt" : "Ausstehend"}
												</span>
											</span>
										</td>
										<td class="py-2.5 pr-2">
											<Icon name="mail" class="h-3.5 w-3.5 text-ink/30" />
										</td>
										<td class="py-2.5 text-right">
											<Icon name="more-horizontal" class="ml-auto h-3.5 w-3.5 text-ink/30" />
										</td>
									</tr>
								))
							}
						</tbody>
					</table>

					<div class="h-44" aria-hidden="true"></div>
				</div>
			</div>
		</div>
	</div>
</section>
